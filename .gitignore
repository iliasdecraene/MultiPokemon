# --- Never commit game files (each player supplies their own ROM) ---
*.gb
*.gbc
*.sav
*.ram
*.state

# --- Local configuration (may contain the room password) ---
config.json
!server/config.example.json

# --- Server runtime data (player snapshots) ---
server/data/

# --- Build output ---
dist/
build/
*.egg-info/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Misc ---
*.log
.DS_Store
Thumbs.db

# --- Local AI-assistant notes (kept per machine, not shared) ---
CLAUDE.md
MEMORY.md

# --- Dev harness inputs (ROM + save states, see dev/README.md) ---
dev/states/

# Nintendo DS (never commit ROMs, saves or save states)
*.nds
*.dsv
*.dsst
*.ds[0-9]
dev/states
